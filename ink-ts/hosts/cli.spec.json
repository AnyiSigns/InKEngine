{
  "id": "cli",
  "kind": "host",
  "capability": "host_tool",
  "implemented": true,
  "host": {
    "surface": "cli",
    "transport": ["terminal", "stdio"],
    "approval": "interactive",
    "ports": {
      "storage": ["sqlite", "memory"],
      "llm": ["llm_port"],
      "exec": ["exec_envelope"],
      "approval": ["interactive", "flag"]
    }
  },
  "runtime": {
    "headless": false,
    "approval_timeout": null,
    "ui_origin": null
  },
  "note": "cli 宿主（唯一进程载体）：stdio/run/serve 三形态；stdio 为 headless 通道、serve 出 http+ws 供 web 呈现面；无自带终端呈现面；运行配置声明化随阶段 5b，密钥外置（config.json/环境）"
}
