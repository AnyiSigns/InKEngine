{
  "id": "web",
  "kind": "host",
  "capability": "host_tool",
  "implemented": true,
  "host": {
    "surface": "web",
    "transport": ["http+ws"],
    "approval": "card",
    "ports": {
      "storage": ["sqlite", "memory"],
      "llm": ["llm_port"],
      "exec": ["exec_envelope"],
      "approval": ["card"]
    },
    "ui_origin": {
      "dev": "vite（渲染器源码 HMR；经 cli serve --vite 代理）",
      "prod": "builtin（同进程托管 web dist）"
    }
  },
  "renderer": {
    "target": "web",
    "entry": "web/src"
  },
  "runtime": {
    "headless": false,
    "approval_timeout": null,
    "ui_origin": null
  },
  "note": "web 宿主面：浏览器为显示设备，经 cli serve http+ws 接同一 bootstrap 进程；ui_origin dev=vite/prod=builtin；热更 = 显示设备源码 HMR（开发工具链），插件热更走运行期 artifactLoader/渲染意图"
}
