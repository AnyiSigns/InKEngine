{
  "name": "@ink-ts/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "web 宿主产品壳（hosts/web/，原 renderer 宿主装配面）：InKling 浏览器呈现面——产品 chrome（App/activate/state/shell/productView）+ 会话数据/动作装配，经 cli serve http+ws 接 bootstrap；显示设备 = @ink-ts/renderer（UIRenderer/注册表/共享资产），壳只装配数据面并注入渲染器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
