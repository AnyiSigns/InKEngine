{
  "id": "sleep",
  "kind": "tool",
  "capability": "host_tool",
  "actions": [],
  "depends": [],
  "data": {
    "tool": {
      "name": "sleep",
      "description": "行为意图：前台等待——在当前回合内休眠指定秒数，睡醒后继续执行；是「时间维度操作」的唯一入口。\n\n使用时机：用户要求「等一会儿再继续」「N 秒后执行某动作」等需要经过一段时间的动作；等待期间回合保持前台，用户停止会话即打断本次休眠与整个回合。\n\n取舍与替代选项：立等可做的动作——直接执行，不该 sleep；后台到点触发——不提供后台驻留机制，统一用本工具前台等待（停止会话即可打断，无后台幽灵任务）。\n\n参数语义：command=固定值 sleep（端点操作判定同源，调用方恒传）；seconds=等待秒数。\n\n边界与协作：休眠为前台工具调用，回合事件正常留痕；等待可被停止按钮打断；无需审批（无害等待）。",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "sleep"
            ],
            "description": "命令名（固定值；与 process_exec 端点操作判定同源，调用方恒传）"
          },
          "seconds": {
            "type": "integer",
            "description": "等待秒数"
          }
        },
        "required": [
          "command",
          "seconds"
        ]
      },
      "permissions": [
        "process:exec:sleep"
      ],
      "approval": "allow",
      "endpoint": "process_exec",
      "endpoint_config": {
        "allowlist": [
          "sleep"
        ]
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "os",
        "control": true,
        "executor": "shell:sleep",
        "sandbox": "process_allowlist"
      }
    }
  }
}
