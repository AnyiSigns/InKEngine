{
  "name": "inkling.ui",
  "version": 3,
  "theme": {
    "bg.base": "#09090b",
    "text.base": "#e4e4e7",
    "accent.approval": "#f59e0b"
  },
  "root": {
    "kind": "container",
    "type": "column",
    "props": {
      "gap": 0,
      "note": "产品主壳（spec 直渲唯一入口）：左右栏 + 主区页签视图；设置/审批为覆盖层。主界面是干活面，机制内容进消息流/演化页，不常驻机制面板"
    },
    "children": [
      {
        "kind": "container",
        "type": "overlay",
        "props": {
          "note": "常驻覆盖层：审批卡/设置浮层（自身带 fixed 定位，不占布局盒位）"
        },
        "children": [
          {
            "kind": "component",
            "type": "review_card",
            "props": {
              "note": "审批卡（events.review_card 到达即弹，决议续跑经壳注入）"
            },
            "bind": {
              "channel": "events.review_card",
              "path": ""
            }
          },
          {
            "kind": "component",
            "type": "settings_floater",
            "props": {
              "note": "设置浮层（注册式节导航驱动，打开态 = 壳 settingsOpen）"
            }
          }
        ]
      },
      {
        "kind": "container",
        "type": "row",
        "props": {
          "grow": true,
          "gap": 0
        },
        "children": [
          {
            "kind": "component",
            "type": "file_tree",
            "props": {
              "note": "左栏（工作区授权 + 设置入口；折叠态本地 UI 保持）",
              "collapsible": true
            }
          },
          {
            "kind": "container",
            "type": "column",
            "props": {
              "grow": true,
              "gap": 0,
              "relative": true,
              "note": "主区：顶栏（悬停 veil，absolute 锚定本列）+ 页签视图"
            },
            "children": [
              {
                "kind": "component",
                "type": "top_bar",
                "props": {
                  "note": "悬停触发带 + 磨砂 veil 覆盖层；标题/页签/待办角标随壳数据"
                }
              },
              {
                "kind": "container",
                "type": "views",
                "props": {
                  "grow": true,
                  "gap": 0,
                  "note": "主区页签内容（chat/evolution/trajectory/todo；视图名 = 壳 tab）"
                },
                "children": [
                  {
                    "kind": "container",
                    "type": "column",
                    "props": {
                      "view": "chat",
                      "gap": 0
                    },
                    "children": [
                      {
                        "kind": "component",
                        "type": "message_list",
                        "props": {
                          "note": "会话消息流（唯一消息渲染面 = MessageStream）",
                          "grow": true
                        },
                        "bind": {
                          "channel": "state.messages",
                          "path": ""
                        }
                      },
                      {
                        "kind": "component",
                        "type": "task_capsule",
                        "props": {
                          "note": "长任务期胶囊（任务在途才渲染，非任务态空）"
                        }
                      },
                      {
                        "kind": "component",
                        "type": "agent_input",
                        "props": {
                          "note": "输入胶囊（发送/中止/附件/模型/推理档位）"
                        },
                        "bind": {
                          "channel": "state.session",
                          "path": ""
                        }
                      }
                    ]
                  },
                  {
                    "kind": "container",
                    "type": "column",
                    "props": {
                      "view": "evolution",
                      "scroll": true,
                      "gap": 0,
                      "note": "状态页：演化动态时间线 + 当前回合图组成 + 机制读取面（审计/发布演示时可见）"
                    },
                    "children": [
                      {
                        "kind": "component",
                        "type": "evolution_feed",
                        "props": {
                          "note": "孵化/补丁链/当前回合图组成/协作者目录"
                        }
                      },
                      {
                        "kind": "component",
                        "type": "mechanism_view",
                        "props": {
                          "note": "机制读取面摘要卡（未装配 = 空态可观测）"
                        }
                      }
                    ]
                  },
                  {
                    "kind": "container",
                    "type": "column",
                    "props": {
                      "view": "trajectory",
                      "scroll": true,
                      "gap": 0
                    },
                    "children": [
                      {
                        "kind": "component",
                        "type": "trajectory_view",
                        "props": {
                          "note": "轨迹页（state.roundSteps 快照）"
                        },
                        "bind": {
                          "channel": "state.roundSteps",
                          "path": ""
                        }
                      }
                    ]
                  },
                  {
                    "kind": "container",
                    "type": "column",
                    "props": {
                      "view": "todo",
                      "scroll": true,
                      "gap": 0
                    },
                    "children": [
                      {
                        "kind": "component",
                        "type": "todo_view",
                        "props": {
                          "note": "待办页（rounds.todos 只读投影）"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "kind": "component",
            "type": "session_list",
            "props": {
              "note": "右栏（会话列表 + 分支 mini 树；折叠态本地 UI 保持）",
              "collapsible": true
            }
          }
        ]
      }
    ]
  }
}
