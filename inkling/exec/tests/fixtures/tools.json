{
  "description": "InKling 起点领域（知识/研究孵化）声明式工具清单：与 exec/ 执行体一一对应，名称/schema 为绑定锚点——工具名与参数形态以 seed_data/tools.json 声明为准（决议 1：seed 为真源），本夹具镜像同形态（exec 参数段定稿后与种子保持一致），执行体新增 = 本文件登记 + executors/ 注册表登记，双侧缺一即绑定测试失败",
  "tools": [
    {
      "name": "collect_material",
      "description": "采集：把研究素材采集回来（文本直取或 URL 取回，产物是未经解析的原始材料，只入料不加工）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "待取回的 URL（经宿主 web_bridge 代理取回，与 text 二选一）" },
          "text": { "type": "string", "description": "直接粘贴的文本内容（与 url 二选一）" },
          "max_bytes": { "type": "integer", "description": "大小上限保护（默认 1 MiB，超出截断并标记）" }
        },
        "required": []
      }
    },
    {
      "name": "parse_material",
      "description": "解析：按声明式抽取规格（between/line_prefix/count/contains）从文本中结构化抽取字段",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "待解析文本" },
          "spec": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "字段名" },
                "kind": { "type": "string", "enum": ["between", "line_prefix", "count", "contains"] },
                "start": { "type": "string", "description": "between：起始标记" },
                "end": { "type": "string", "description": "between：结束标记" },
                "prefix": { "type": "string", "description": "line_prefix：行前缀" },
                "include_prefix": { "type": "boolean", "description": "line_prefix：结果是否含前缀" },
                "needle": { "type": "string", "description": "count/contains：查找串" }
              },
              "required": ["name", "kind"]
            },
            "description": "抽取规格清单"
          }
        },
        "required": ["text", "spec"]
      }
    },
    {
      "name": "validate_material",
      "description": "校验：以 rules.json 规则集对数据对象执行确定性规则谓词评估（谓词名/违规形态与引擎规则引擎对齐，含样例闸门同语义的 fail-open 留痕）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "data": { "type": "object", "description": "待校验的数据对象（材料/知识条目）" },
          "rules": {
            "type": "array",
            "items": { "type": "string" },
            "description": "规则 id 子集（缺省全量）"
          }
        },
        "required": ["data"]
      }
    },
    {
      "name": "score_material",
      "description": "评分：候选答案的引用质量（引用可验证性）+ 交叉验证（断言与样例库基准事实重叠度）确定性评分",
      "inputSchema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "claims": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] } },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claim_index": { "type": "integer" },
                    "source_id": { "type": "string" },
                    "quote": { "type": "string" }
                  },
                  "required": ["claim_index", "source_id", "quote"]
                }
              }
            },
            "required": ["claims"]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "text": { "type": "string" } },
              "required": ["id", "text"]
            }
          },
          "weights": {
            "type": "object",
            "description": "四维度权重覆盖（缺省 = 出厂默认口径，总和 1.0）"
          }
        },
        "required": ["answer"]
      }
    },
    {
      "name": "review_material",
      "description": "评审：按 review.json 维度配置加权打分 + 阈值判定 + 收敛决策（镜像引擎 WeightedScorer 与 MaxRoundsConvergencePolicy 语义）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "claims": { "type": "array", "items": { "type": "string" } },
                "citations": { "type": "array", "items": { "type": "object", "properties": { "source_id": { "type": "string" } }, "required": ["source_id"] } },
                "topic": { "type": "string" }
              }
            },
            "description": "待评审候选清单"
          },
          "dimension_scores": {
            "type": "array",
            "description": "显式维度得分（缺省 = 确定性启发式默认口径）；显式提供时该候选全部配置维度须齐全",
            "items": {
              "type": "object",
              "properties": {
                "candidate_index": { "type": "integer" },
                "name": { "type": "string" },
                "score": { "type": "number" }
              },
              "required": ["candidate_index", "name", "score"]
            }
          },
          "round_no": { "type": "integer", "description": "当前再生成轮次（收敛决策用）" }
        },
        "required": ["candidates"]
      }
    },
    {
      "name": "distill_knowledge",
      "description": "蒸馏：按 signals.json 信号→蒸馏器映射把信号序列压缩为结构化知识（{kind: insight, insight: {message, context, note}} 引擎教训条目形态），丢弃试错分支",
      "inputSchema": {
        "type": "object",
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string" },
                "message": { "type": "string" },
                "source": { "type": "string" },
                "context": { "type": "object" }
              },
              "required": ["kind", "message"]
            },
            "description": "待蒸馏信号序列"
          },
          "complexity": { "type": "integer", "description": "任务复杂度（蒸馏按需触发判定用）" },
          "interventions": { "type": "integer", "description": "用户干预次数（蒸馏按需触发判定用）" }
        },
        "required": ["signals"]
      }
    },
    {
      "name": "mutate_knowledge",
      "description": "变异：反思式变体生成（失败日志 → 变异体知识数据，镜像引擎 DeterministicMutation——_mutation 留痕 + 动态变体数量），产物须过三层闸门才保留",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "level": { "type": "string" },
              "kind": { "type": "string" },
              "data": { "type": "object", "description": "条目数据（变异基底）" },
              "source": { "type": "string" },
              "credibility": { "type": "number" },
              "title": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "data"]
          },
          "failure_logs": { "type": "array", "items": { "type": "string" }, "description": "近期失败日志（反思式变异输入）" },
          "max_variants": { "type": "integer", "description": "变体数量上限（默认 3）" },
          "failure_rate": { "type": "number", "description": "母体失败率（≥0.3 高失败率 → 多探索）" }
        },
        "required": ["entry", "failure_logs"]
      }
    }
  ]
}
