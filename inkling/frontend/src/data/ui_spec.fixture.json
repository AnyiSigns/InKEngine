{
  "name": "inkling.ui",
  "version": 2,
  "root": {
    "kind": "container",
    "type": "app",
    "children": [
      {
        "kind": "container",
        "type": "views",
        "children": [
          {
            "kind": "container",
            "type": "row",
            "props": { "view": "main", "gap": 0 },
            "children": [
              {
                "kind": "component",
                "type": "file_tree",
                "props": { "collapsible": true }
              },
              {
                "kind": "container",
                "type": "column",
                "props": { "grow": true },
                "children": [
                  {
                    "kind": "component",
                    "type": "message_list",
                    "bind": { "channel": "state.messages", "path": "" }
                  },
                  {
                    "kind": "component",
                    "type": "knowledge_row",
                    "bind": { "channel": "events.memory_recall", "path": "" }
                  },
                  {
                    "kind": "component",
                    "type": "agent_input",
                    "bind": { "channel": "state.session", "path": "" }
                  }
                ]
              },
              {
                "kind": "component",
                "type": "session_list",
                "props": { "collapsible": true }
              }
            ]
          },
          {
            "kind": "container",
            "type": "column",
            "props": { "view": "settings" },
            "children": [
              {
                "kind": "component",
                "type": "view_header",
                "props": { "title": "设置", "hint": "入口 + 系统配置" }
              },
              {
                "kind": "component",
                "type": "settings_form",
                "bind": { "channel": "state.session", "path": "" }
              }
            ]
          },
          {
            "kind": "container",
            "type": "column",
            "props": { "view": "evolution", "scroll": true },
            "children": [
              {
                "kind": "component",
                "type": "view_header",
                "props": { "title": "演化", "hint": "孵化 · 进化 · 补丁链" }
              },
              {
                "kind": "component",
                "type": "incubator_panel",
                "bind": { "channel": "state.incubation", "path": "" }
              },
              {
                "kind": "component",
                "type": "evolution_factory",
                "bind": { "channel": "state.incubation", "path": "" }
              },
              {
                "kind": "component",
                "type": "evolution_timeline",
                "bind": { "channel": "inspect_graph", "path": "patchChain" }
              }
            ]
          },
          {
            "kind": "container",
            "type": "column",
            "props": { "view": "simulation", "scroll": true },
            "children": [
              {
                "kind": "component",
                "type": "view_header",
                "props": { "title": "推演", "hint": "simulate_decision · 分支对比" }
              },
              {
                "kind": "component",
                "type": "simulation_tree",
                "bind": { "channel": "state.simulations", "path": "" }
              }
            ]
          },
          {
            "kind": "container",
            "type": "column",
            "props": { "view": "source", "scroll": true },
            "children": [
              {
                "kind": "component",
                "type": "view_header",
                "props": { "title": "来源", "hint": "依据链溯源" }
              },
              {
                "kind": "component",
                "type": "source_trace",
                "bind": { "channel": "state.sourceTraces", "path": "" }
              }
            ]
          }
        ]
      },
      {
        "kind": "container",
        "type": "overlay",
        "children": [
          {
            "kind": "component",
            "type": "review_card",
            "bind": { "channel": "events.review_card", "path": "" }
          }
        ]
      }
    ]
  }
}
