{
  "id": "inkling",
  "name": "InKling",
  "positioning": "你用得越多，它越懂你的领域",
  "domain_boot": "知识/研究孵化",
  "version": "0.1.0",
  "engine_version_compat": "0.1.0",
  "theme": {
    "bg.base": "#09090b",
    "text.base": "#e4e4e7",
    "accent.approval": "#f59e0b",
    "note": "墨色系语义 token：bg.base 深墨底 / text.base 纸白字 / accent.approval 审批卡出厂默认朱砂；token 值随主题补丁（PatchKind.THEME）演化，组件一律经 token 取色"
  },
  "contracts": {
    "exec_mcp_id": "inkling_exec",
    "host_id": "inkling_shell",
    "renderer_components": [
      "agent_input",
      "admin_console",
      "admin_tools",
      "architecture_view",
      "evolution_factory",
      "evolution_timeline",
      "file_tree",
      "incubator_panel",
      "knowledge_row",
      "message_list",
      "review_card",
      "session_list",
      "settings_form",
      "simulation_tree",
      "source_trace",
      "summary_bar",
      "ui_spec_editor",
      "view_header"
    ],
    "bind_channels": [
      "state",
      "state.messages",
      "state.session",
      "events.reply_token",
      "events.thinking_start",
      "events.plan_start",
      "events.spawn_start",
      "events.tool_start",
      "events.simulate_decision",
      "events.review_card",
      "events.suggestions",
      "events.error",
      "events.signal_detected",
      "events.distill_outcome",
      "events.gate_verdict",
      "events.evolution_variant",
      "events.patch_applied",
      "events.patch_reverted",
      "events.memory_recall",
      "events.tuning_update",
      "events.vetting_result",
      "events.device_sensed",
      "events.device_control",
      "inspect_graph",
      "inspect_rules",
      "inspect_knowledge",
      "inspect_ui",
      "inspect_tools"
    ],
    "event_types": {
      "file": "seed_data/event_types.json"
    },
    "tools": {
      "file": "seed_data/tools.json"
    },
    "build": {
      "file": "seed_data/build.json"
    },
    "theme_tokens": [
      "bg.base",
      "text.base",
      "accent.approval"
    ]
  },
  "self_check": {
    "schema": {
      "command": "cargo run --release --manifest-path inkling/self_check/Cargo.toml -- schema",
      "status": "ready"
    },
    "cargo_test": {
      "command": "cargo run --release --manifest-path inkling/self_check/Cargo.toml -- cargo",
      "status": "ready"
    },
    "frontend": {
      "command": "cargo run --release --manifest-path inkling/self_check/Cargo.toml -- frontend",
      "status": "ready"
    },
    "e2e": {
      "command": "cargo run --release --manifest-path inkling/self_check/Cargo.toml -- e2e",
      "status": "ready"
    }
  }
}
