        "required": []
      },
      "permissions": [
        "mcp:call:inkling_shell"
      ],
      "approval": "review",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_shell"
      },
      "network_policy": {
        "allow_domains": []
