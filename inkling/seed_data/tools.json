          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "启动参数"
          }
        },
        "required": [
          "command",
          "app"
        ]
      },
      "permissions": [
        "process:exec:launch_app"
      ],
      "approval": "review",
      "endpoint": "process_exec",
      "endpoint_config": {
