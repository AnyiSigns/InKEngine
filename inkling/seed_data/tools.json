      "meta": {
        "domain": "os",
        "sensor": "screen",
        "executor": "shell:device_sense",
        "sandbox": "server_session"
      }
    },
    {
      "name": "file_query",
      "description": "OS 感知：文件状态查询（工作区外只读扫描，宿主件挂载接线）",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "待查询路径"
          },
          "pattern": {
            "type": "string",
            "description": "文件名过滤模式"
          }
