      "meta": {
        "domain": "os",
        "sensor": "file",
        "executor": "shell:device_sense",
        "sandbox": "server_session"
      }
    },
    {
      "name": "system_query",
      "description": "OS 感知/状态：系统状态查询（CPU/内存/进程概览；shell 执行器注册）",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "system_query"
            ],
            "description": "命令名（固定值；与 process_exec 端点操作判定同源，调用方恒传）"
          },
          "scope": {
            "type": "string",
            "enum": [
              "system",
              "process",
              "disk"
            ],
            "description": "查询范围"
          }
        },
        "required": [
          "command",
          "scope"
        ]
      },
      "permissions": [
        "process:exec:system_query"
      ],
      "approval": "allow",
      "endpoint": "process_exec",
      "endpoint_config": {
        "allowlist": [
          "system_query"
        ]
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "os",
        "executor": "shell:system_query",
        "sandbox": "process_allowlist"
      }
    },
    {
      "name": "launch_app",
      "description": "OS 控制：启动应用（shell 执行器注册；首次越界操作强制 L2 人工审批）",
