{
  "tools": [
    {
      "name": "collect_material",
      "description": "采集研究材料（文本/URL 取回），输出原始材料（title/text/source）",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "待取回的 URL"
          },
          "text": {
            "type": "string",
            "description": "直接粘贴的文本内容"
          }
        },
        "required": []
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "review",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": [],
        "note": "出网行为由 inkling_exec server 侧策略约束，挂载时经 vetting 核对"
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_collect",
        "sandbox": "server_session"
      }
    },
    {
      "name": "parse_material",
      "description": "解析材料：结构化抽取（标题/正文/要点/来源引用）",
      "parameters": {
        "type": "object",
        "properties": {
          "material": {
            "type": "object",
            "description": "待解析的原始材料对象"
          }
        },
        "required": [
          "material"
        ]
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "allow",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_parse",
        "sandbox": "server_session"
      }
    },
    {
      "name": "validate_material",
      "description": "校验材料/知识条目：按 rules.json 规则谓词评估，输出违规清单",
      "parameters": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "待校验的数据对象（材料/知识条目）"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "规则 id 子集（缺省全量）"
          }
        },
        "required": [
          "data"
        ]
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "allow",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_validate",
        "sandbox": "server_session"
      }
    },
    {
      "name": "score_material",
      "description": "评分：引用质量/交叉验证维度打分（0-1），供评审与收敛使用",
      "parameters": {
        "type": "object",
        "properties": {
          "material": {
            "type": "object",
            "description": "解析后的材料对象"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "评分维度子集（缺省全量）"
          }
        },
        "required": [
          "material"
        ]
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "allow",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_score",
        "sandbox": "server_session"
      }
    },
    {
      "name": "review_material",
      "description": "评审：按 review.json 维度/阈值对候选输出打分与给出改进意见（收敛循环的评审执行体）",
      "parameters": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "候选输出清单"
          },
          "context": {
            "type": "object",
            "description": "评审上下文"
          }
        },
        "required": [
          "candidates"
        ]
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "review",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_review",
        "sandbox": "server_session"
      }
    },
    {
      "name": "distill_knowledge",
      "description": "蒸馏：信号序列 → 结构化知识数据（丢弃试错分支，产出 rule 形态声明）",
      "parameters": {
        "type": "object",
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "执行信号序列（五类）"
          }
        },
        "required": [
          "signals"
        ]
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "review",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_distill",
        "sandbox": "server_session"
      }
    },
    {
      "name": "mutate_knowledge",
      "description": "变异：按失败日志反思式生成知识条目变体（进化工厂的变异执行体）",
      "parameters": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "object",
            "description": "母体知识条目"
          },
          "failure_logs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "近期失败日志"
          }
        },
        "required": [
          "entry",
          "failure_logs"
        ]
      },
      "permissions": [
        "mcp:call:inkling_exec"
      ],
      "approval": "review",
      "endpoint": "mcp",
      "endpoint_config": {
        "server_id": "inkling_exec"
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "research",
        "executor": "inkling_exec:inkling_mutate",
        "sandbox": "server_session"
      }
    },
    {
      "name": "screen_query",
      "description": "OS 感知：屏幕状态查询（设备感知 server，宿主件挂载接线）",
      "parameters": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "description": "屏幕区域/元素定位"
          }
