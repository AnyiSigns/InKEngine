    {
      "name": "shell_exec",
      "description": "OS 控制：任意命令执行（出厂 deny 档——默认拒绝，须经补丁链显式转正才可用；权限契约不得擅自放宽）",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "shell_exec"
            ],
            "description": "命令名（固定值；与 process_exec 端点操作判定同源，调用方恒传）"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "待执行命令参数"
          }
        },
        "required": [
          "command"
        ]
      },
      "permissions": [
        "process:exec:shell_exec"
      ],
      "approval": "deny",
      "endpoint": "process_exec",
      "endpoint_config": {
        "allowlist": [
          "shell_exec"
        ]
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "os",
        "control": false,
        "deny_by_default": true,
        "executor": "host:shell_exec_guard",
        "sandbox": "process_allowlist",
        "note": "三档权限契约的 deny 档样例：任何调用在门禁处拒绝，权限变更须经审批"
      }
    },
    {
      "name": "fetch_web",
      "description": "网络抓取：经 http_fetch 端点取回网页内容（域名白名单 = 出厂网络策略，越域拒绝）",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "待抓取 URL（域名须在 network_policy.allow_domains 白名单内）"
          }
        },
        "required": [
          "url"
        ]
      },
      "permissions": [
        "network:connect:arxiv.org"
      ],
      "approval": "review",
      "endpoint": "http_fetch",
      "endpoint_config": {
        "method": "GET"
      },
      "network_policy": {
        "allow_domains": [
          "arxiv.org"
        ],
        "note": "出厂网络策略：研究场景仅放行 arXiv 主域（数据驱动，可经 TOOL 补丁演化）"
      },
      "meta": {
        "domain": "network",
        "executor": "host:fetch_web",
        "sandbox": "network_policy",
        "size_limit_bytes": 100000
      }
    },
    {
