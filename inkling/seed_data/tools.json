      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": ["propose_mcp_mount"],
            "description": "命令名（固定值；与 process_exec 端点操作判定同源，调用方恒传）"
          },
          "address": {
            "type": "string",
            "description": "插件地址（市场条目 id / git 仓库 / npm 包名）"
          }
        },
        "required": [
          "command",
          "address"
        ]
      },
      "permissions": [
        "process:exec:propose_mcp_mount"
      ],
      "approval": "review",
      "endpoint": "process_exec",
      "endpoint_config": {
        "allowlist": [
          "propose_mcp_mount"
        ]
      },
      "network_policy": {
        "allow_domains": []
      },
      "meta": {
        "domain": "self",
        "executor": "host:propose_mcp_mount",
        "sandbox": "process_allowlist",
        "note": "执行器由宿主注册（M3 接线）；挂载链路 = vetting 静态钩子 → 审批卡 → L2 → 补丁链"
      }
    },
    {
      "name": "file_read",
