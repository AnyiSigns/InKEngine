{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "组件市场目录（候选组件清单；消费 = 前端组件市场入口 bindValue 注入）",
  "type": "object",
  "required": ["premounted", "mount_policy", "components"],
  "additionalProperties": false,
  "properties": {
    "premounted": { "type": "boolean" },
    "mount_policy": {
      "type": "object",
      "required": ["required", "note"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "version", "risk", "test_manifest", "maintenance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "risk_note": { "type": "string" },
          "artifact_url": { "type": "string", "minLength": 1 },
          "test_manifest": {
            "type": "object",
            "required": ["required", "note"],
            "additionalProperties": false,
            "properties": {
              "required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "note": { "type": "string", "minLength": 1 }
            }
          },
          "maintenance": { "type": "string", "enum": ["maintained", "experimental", "archived"] }
        }
      }
    }
  }
}
