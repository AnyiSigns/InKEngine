{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "事件类型注册表（EventTypeSpec 数据形态）",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/event" } }
  },
  "definitions": {
    "event": {
      "type": "object",
      "required": ["name", "renderer", "system"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
        "schema": { "$ref": "#/definitions/schema_spec" },
        "renderer": { "type": "string", "minLength": 1 },
        "system": { "type": "boolean" },
        "meta": { "type": "object" }
      }
    },
    "schema_spec": {
      "type": "object",
      "required": ["name", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/schema_field" } }
      }
    },
    "schema_field": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "kind": { "type": "string", "enum": ["string", "number", "boolean", "object", "array"] },
        "enum": { "type": "array", "items": { "type": "string" } },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string" }
      }
    }
  }
}
