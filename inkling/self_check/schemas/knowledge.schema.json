{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "冷启动知识条目（KnowledgeEntry 数据形态）",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id", "level", "kind", "data", "source", "credibility"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "enum": ["work", "project", "user"] },
        "kind": { "type": "string", "enum": ["rule", "template", "weight", "tool_rule"] },
        "data": { "type": "object" },
        "source": { "type": "string", "enum": ["web", "dialog", "model", "user"] },
        "credibility": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "usage_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 },
        "failure_logs": { "type": "array", "items": { "type": "string" } },
        "archived": { "type": "boolean" },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" }
      }
    }
  }
}
