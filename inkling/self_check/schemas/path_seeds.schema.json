{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "路径种子语料（边证据导入的出厂路径先验；消费 = boot 路径组装域）",
  "type": "object",
  "required": ["seed_paths", "edge_defaults"],
  "additionalProperties": false,
  "properties": {
    "seed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "title", "description", "chain", "edge_stats"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "chain": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "edge_stats": {
            "type": "object",
            "required": ["success_count", "fail_count"],
            "additionalProperties": false,
            "properties": {
              "success_count": { "type": "number", "minimum": 0 },
              "fail_count": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "edge_defaults": {
      "type": "object",
      "required": ["success_count", "fail_count"],
      "additionalProperties": false,
      "properties": {
        "success_count": { "type": "number", "minimum": 0 },
        "fail_count": { "type": "number", "minimum": 0 },
        "avg_cost": { "type": "number", "minimum": 0 },
        "src_contract_version": { "type": "string", "minLength": 1 },
        "dst_contract_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
