{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "评审/收敛配置（维度/阈值/轮次上限/web 验证钩子开关）",
  "type": "object",
  "required": ["dimensions", "pass_threshold", "max_rounds", "beam_width", "neutral_score", "web_verify"],
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "weight"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_rounds": { "type": "integer", "minimum": 0 },
    "beam_width": { "type": "integer", "minimum": 1 },
    "neutral_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "evolve_interval_rounds": { "type": "integer", "minimum": 1 },
    "web_verify": {
      "type": "object",
      "required": ["enabled", "hook"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hook": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "note": { "type": "string" }
  }
}
