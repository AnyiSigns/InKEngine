{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "模型分层挡位配置（main/router 双挡 + 缺省回退，与引擎 tiers 语义同源）",
  "type": "object",
  "required": ["tiers", "default_tier", "model_config", "fallback"],
  "additionalProperties": false,
  "properties": {
    "tiers": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
    "default_tier": { "type": "string", "minLength": 1 },
    "model_config": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/tier_config"
      }
    },
    "fallback": {
      "type": "object",
      "required": ["unknown_tier_falls_to", "missing_tier_config_falls_to"],
      "additionalProperties": false,
      "properties": {
        "unknown_tier_falls_to": { "type": "string", "minLength": 1 },
        "missing_tier_config_falls_to": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    }
  },
  "definitions": {
    "tier_config": {
      "type": "object",
      "required": ["purpose", "requires_user_config"],
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "requires_user_config": { "type": "boolean" }
      }
    }
  }
}
