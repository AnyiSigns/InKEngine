{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "声明式工具清单（DeclarativeToolSpec 数据形态 + 权限分级/网络策略/沙箱端点）",
  "type": "object",
  "required": ["tools"],
  "additionalProperties": false,
  "properties": {
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/tool" } }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["name", "description", "parameters", "permissions", "approval", "endpoint", "endpoint_config", "network_policy", "meta"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "approval": { "type": "string", "enum": ["allow", "review", "deny"] },
        "endpoint": { "type": "string", "enum": ["http_fetch", "process_exec", "file_ops", "mcp", "web_search", "collab_request"] },
        "endpoint_config": { "type": "object" },
        "network_policy": {
          "type": "object",
          "required": ["allow_domains"],
          "additionalProperties": true,
          "properties": {
            "allow_domains": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        "meta": { "type": "object" }
      }
    }
  }
}
