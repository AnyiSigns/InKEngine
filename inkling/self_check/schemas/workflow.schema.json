{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "研究流程 WorkflowSpec（__plan__ 约束域 + 多链分流 + 推演档位）",
  "type": "object",
  "required": ["name", "nodes", "edges", "entry"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "config"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "config": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entry": { "type": "string", "minLength": 1 },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "entry", "nodes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "nodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "simulation_policy": {
      "type": "object",
      "required": ["default", "tiers"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "tiers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["max_simulations", "quota_per_round"],
            "additionalProperties": false,
            "properties": {
              "max_simulations": { "type": "integer", "minimum": 0 },
              "quota_per_round": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
