{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InKling",
  "version": "0.1.0",
  "identifier": "com.inkling.evo",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5176",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InKling",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://localhost:5176 ws://localhost:5176; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "InKling：受控自进化智能体，你用得越多，它越懂你的领域",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": [
      "resources/python/",
      "resources/granite-97m/",
      "resources/whisper/",
      "resources/ink_engine/",
      "resources/inkling/",
      "resources/exec/"
    ]
  }
}