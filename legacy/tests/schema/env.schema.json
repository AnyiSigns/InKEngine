{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "环境声明（EnvironmentSpec 数据形态；local/web_bridge/container）",
  "type": "object",
  "required": ["environments"],
  "additionalProperties": false,
  "properties": {
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "runtime"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "enum": ["local", "web_bridge", "container"] },
          "tools": { "type": "array", "items": { "type": "string" } },
          "install_cmds": { "type": "array", "items": { "type": "string" } },
          "version": { "type": "string" },
          "meta": { "type": "object" }
        }
      }
    }
  }
}
