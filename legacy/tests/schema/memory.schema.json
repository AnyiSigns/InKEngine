{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "记忆策略声明（PriorityRecallPolicy + 失效窗口）",
  "type": "object",
  "required": ["policy", "recall", "expiry", "namespaces", "kinds", "store"],
  "additionalProperties": false,
  "properties": {
    "policy": { "type": "string", "minLength": 1 },
    "recall": {
      "type": "object",
      "required": ["sort", "default_limit"],
      "additionalProperties": false,
      "properties": {
        "sort": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "default_limit": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "expiry": {
      "type": "object",
      "required": ["default_window_days", "forget_semantics"],
      "additionalProperties": false,
      "properties": {
        "default_window_days": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string" },
        "forget_semantics": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "kinds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "store": {
      "type": "object",
      "required": ["backend", "collection"],
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "collection": { "type": "string", "minLength": 1 }
      }
    }
  }
}
