{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "样例库（FixtureSet/FixtureCase 数据形态，L2 验证 fixture）",
  "type": "object",
  "required": ["name", "cases"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/case" } },
    "facts": {
      "type": "array",
      "minItems": 1,
      "description": "基准事实清单：评分执行体交叉验证维度的锚点（语句可与用例内容做归一化重叠判定）",
      "items": { "$ref": "#/definitions/fact" }
    }
  },
  "definitions": {
    "fact": {
      "type": "object",
      "required": ["id", "statement"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "data": { "type": "object" },
        "context": { "type": "object" },
        "expected_pass": { "type": "boolean" },
        "expected_kinds": { "type": "array", "items": { "type": "string" } },
        "unexpected_kinds": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    }
  }
}
