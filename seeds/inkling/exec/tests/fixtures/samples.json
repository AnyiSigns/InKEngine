{
  "name": "inkling.research",
  "description": "样例库：规则集与执行件的数据绑定验证（fixture 全绿非谈判项）——cases 镜像引擎 FixtureSet 形态（id/data/context/expected_pass/expected_kinds），facts 为评分执行体交叉验证的基准事实清单（集成时以 M0 seed_data/samples.json 定稿为准）",
  "cases": [
    {
      "id": "valid_entry",
      "data": {
        "title": "溯源方法论",
        "title_length": 6,
        "kind": "insight",
        "source": "model",
        "evidence": "样例证据：证据字段非空",
        "text": "自进化系统把使用中积累的理解沉淀为可信知识。",
        "credibility": 0.8,
        "count": 2,
        "limit": 5,
        "tags": [{ "tag": "方法" }, { "tag": "溯源" }],
        "from_state": "draft",
        "to_state": "reviewing"
      },
      "expected_pass": true,
      "description": "合法条目：全部谓词通过（零违规）"
    },
    {
