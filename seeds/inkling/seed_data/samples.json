{
  "name": "inkling.baseline",
  "cases": [
    {
      "id": "full_loop_baseline",
      "data": {
        "material": {
          "title": "墨引擎机制概览",
          "text": "墨引擎是通用 agent 机制引擎内核，提供图执行/补丁链/知识孵化等机制。",
          "source": "web"
        },
        "entry": {
          "data": {
            "rule": {
              "message": "知识条目落库须过三层闸门（L1 形式 / L2 样例全绿 / L3 不劣于旧版）",
              "context": { "domain": "knowledge_research" }
            }
          }
        },
        "review": { "score": 0.85 },
        "case": { "input": "喂资料 → 研究 → 孵化 → 沉淀 闭环基线样例", "expected": "全绿" }
      },
      "context": {},
      "expected_pass": true,
      "description": "闭环基线：材料/知识条目/评审/样例全合规，八条规则零违规"
    },
    {
      "id": "full_loop_with_user_correction",
      "data": {
        "material": {
          "title": "用户修正反例",
          "text": "用户对回答提出修正（反例），蒸馏为规则条目。",
          "source": "dialog"
        },
        "entry": {
          "data": {
            "rule": {
              "message": "引用网页资料时须给出来源链接，不得含糊表述",
              "context": { "signal_kind": "user_correction", "source": "user" }
            }
          }
        },
        "review": { "score": 0.9 },
        "case": { "input": "用户修正反例蒸馏产物", "expected": "落库前过闸门" }
      },
      "context": { "origin": "user_correction" },
      "expected_pass": true,
      "description": "孵化闭环形态：user_correction 信号蒸馏出的规则条目（携带来源与信号上下文）过全量规则"
    },
