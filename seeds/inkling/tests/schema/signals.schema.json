{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "五类信号 → 蒸馏器映射（孵化入口）",
  "type": "object",
  "required": ["signal_kinds", "distill", "produced_kinds"],
  "additionalProperties": false,
  "properties": {
    "signal_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "distiller", "produced_kind", "note"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "distiller": { "type": "string", "minLength": 1 },
          "produced_kind": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "distill": {
      "type": "object",
      "required": ["enabled", "tier", "complexity_threshold", "intervention_threshold", "repeat_threshold"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "tier": { "type": "string", "enum": ["main", "router"] },
        "complexity_threshold": { "type": "integer", "minimum": 0 },
        "intervention_threshold": { "type": "integer", "minimum": 0 },
        "repeat_threshold": { "type": "integer", "minimum": 2 },
        "note": { "type": "string" }
      }
    },
    "produced_kinds": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
