{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "界面描述（§5.2 三级信息架构 + 绑定协议 + 主题 token）",
  "type": "object",
  "required": ["name", "version", "theme", "root"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "theme": {
      "type": "object",
      "required": ["bg.base", "text.base", "accent.approval"],
      "additionalProperties": false,
      "properties": {
        "bg.base": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text.base": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent.approval": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "root": { "$ref": "#/definitions/node" }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["kind", "type"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["container", "component"] },
        "type": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bind": {
          "type": "object",
          "required": ["channel", "path"],
          "additionalProperties": false,
          "properties": {
            "channel": { "type": "string", "minLength": 1 },
            "path": { "type": "string" }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/definitions/node" } }
      }
    }
  }
}
